BOT_TOKEN=123456789:replace_with_telegram_bot_token
BACKEND_URL=http://localhost:8000
BOT_API_PORT=8081
INTERNAL_TOKEN=changeme
ADMIN_TOKEN=changeme-admin
BOT_ADMIN_IDS=[]

# Docker/Compose: durable delivery journal in a writable persistent volume.
# For python -m bot, export DELIVERY_DB_PATH="$PWD/var/deliveries.sqlite"
# in the shell: bot/web.py reads this variable from the process environment.
DELIVERY_DB_PATH=/app/var/deliveries.sqlite
